#!/bin/sh
# Jalankan bot Folester (pakai pengaturan dari config.json).
# Bisa dipanggil sebagai `mulai` dari mana saja setelah dipasang sekali:
#   cd ~/folester-termux-bot && git pull && sh pasang
#   source ~/.bashrc
#   mulai
# (JANGAN symlink langsung ke file ini: file di repo tidak punya izin
# eksekusi, symlink-nya ikut gagal "Permission denied". `pasang` membuat
# wrapper di ~/bin yang menjalankan file ini lewat `sh`.)
# (tetap bisa juga dipakai lama: cd ~/folester-termux-bot && ./mulai —
# kalau "Permission denied", jalankan dulu chmod +x mulai mulai2)
# Kalau belum ada config.json, jalankan dulu: python3 atur.py
#
# Kenapa dulu kadang kelihatan stuck: `git pull` nunggu jaringan tanpa batas
# waktu kalau perintah `timeout` tidak terpasang di Termux (cabang else lama
# menjalankan `git pull` polos tanpa batas apa pun), dan selama 15 detik itu
# layar diam tanpa tanda apa-apa — jadi wajar kalau dikira macet lalu
# di-Ctrl+C sebelum PID sempat muncul. Versi ini: `git pull` dijalankan di
# background dengan titik kemajuan tiap detik dan batas keras 10 detik
# (murni shell, tidak butuh `timeout`), plus pesan di awal supaya jelas
# berapa lama menunggunya. Total `mulai` paling lama ~12 detik.

# Cari folder repo yang benar, walau dipanggil lewat symlink di ~/bin.
# `readlink -f` mengikuti symlink sampai ke file aslinya.
SCRIPT="$0"
if command -v readlink >/dev/null 2>&1; then
  RESOLVED=$(readlink -f "$SCRIPT" 2>/dev/null || echo "$SCRIPT")
else
  RESOLVED="$SCRIPT"
fi
DIR=$(dirname "$RESOLVED")
# Kalau folder hasil resolve tidak berisi config.json (mis. symlink),
# pakai folder repo standar di HP.
if [ ! -f "$DIR/config.json" ] && [ -f "$HOME/folester-termux-bot/config.json" ]; then
  DIR="$HOME/folester-termux-bot"
fi
cd "$DIR" || exit 1
if [ ! -f config.json ]; then
  echo "Belum ada config.json — jalankan dulu: python3 atur.py"
  exit 1
fi
echo "Memulai bot Folester... (tunggu sampai muncul PID, sekitar 5-15 detik — jangan Ctrl+C)"
echo "Mematikan bot lama..."
# (1) File PID yang ditulis bot baru (bot.py, per file cookie) — paling tepat.
if [ -f "$HOME/.folester_session_cookies.txt.pid" ]; then
  OLDPID=$(cat "$HOME/.folester_session_cookies.txt.pid" 2>/dev/null)
  if [ -n "$OLDPID" ] && kill -0 "$OLDPID" 2>/dev/null; then kill "$OLDPID" 2>/dev/null; fi
fi
# (2) Bot lama yang dijalankan dengan flag --cookies (mulai versi baru
# menulis flag itu di command line) — pkill pakai nama cookie-nya.
pkill -f "folester_session_cookies.txt" 2>/dev/null
# (3) Fallback paling lama: bot yang dijalankan tanpa flag (command line
# tepat "python3 bot.py"). Pola lama `python3 bot.py$` GAGAL mematikan bot
# yang dijalankan pakai flag apa pun — itu penyebab dua/ tiga bot jalan
# bersamaan di wallet yang sama, beli dobel, dan saldo terkuras.
pkill -f "python3 bot.py$" 2>/dev/null  # bot akun kedua (mulai2) dibiarkan jalan
echo "  bot lama dimatikan."
sleep 1
echo "Mengupdate dari GitHub (maks 10 detik — titik-titik di bawah tandanya masih jalan)..."
# `git pull` di background + titik kemajuan tiap detik + batas keras 10 dtk.
# Sengaja murni shell: tidak butuh perintah `timeout` (belum tentu ada di
# Termux — cabang else lama justru menjalankan `git pull` polos tanpa batas,
# itu yang bikin layar diam selamanya saat jaringan lambat).
# `git pull` itu satu proses (yang nyangkut di jaringan ya proses git-nya
# sendiri), jadi `kill PID` langsung mematikannya — tidak perlu `set -m`
# (job control justru error "can't access tty" kalau stdin bukan terminal).
# GIT_TERMINAL_PROMPT=0 supaya git tidak pernah berhenti menunggu input
# username/password di layar (satu lagi penyebab kelihatan stuck).
GIT_TERMINAL_PROMPT=0 git pull -q 2>/dev/null &
_GP=$!
_i=0
while kill -0 "$_GP" 2>/dev/null && [ "$_i" -lt 10 ]; do
  sleep 1
  _i=$((_i+1))
  printf "."
done
echo
if kill -0 "$_GP" 2>/dev/null; then
  kill "$_GP" 2>/dev/null
  wait "$_GP" 2>/dev/null
  echo "  (update dilewati: git pull >10 dtk — lanjut pakai versi lokal)"
elif wait "$_GP" 2>/dev/null; then
  echo "  (update selesai)"
else
  echo "  (update gagal — lanjut pakai versi lokal)"
fi
echo "Menjalankan bot..."
# --cookies ditulis eksplisit supaya bot lama bisa dimatikan lagi lewat
# pkill -f "folester_session_cookies.txt" di atas (dan supaya bot.py bisa
# menulis file PID-nya di ~/.folester_session_cookies.txt.pid).
nohup python3 bot.py --cookies ~/.folester_session_cookies.txt > folester.log 2>&1 &
echo "Bot jalan (PID $!). Cek log: log"
