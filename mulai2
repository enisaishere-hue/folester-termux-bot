#!/bin/sh
# Jalankan bot akun kedua (AKG8) — pengaturan dari config.json, tapi keypair
# dan file cookie sesi sendiri (supaya tidak bentrok dengan bot utama).
# Bot utama tetap jalan; mulai2 hanya mematikan bot akun kedua yang lama.
# Bisa dipanggil sebagai `mulai2` dari mana saja setelah dipasang sekali:
#   cd ~/folester-termux-bot && sh pasang
# (lihat `mulai` untuk alasannya: symlink langsung gagal karena file repo
# tidak punya izin eksekusi.)
# Sama seperti `mulai`: mencetak tiap langkah dan `git pull` di background
# dengan titik kemajuan + batas keras 10 detik (murni shell, tanpa `timeout`),
# supaya tidak kelihatan stuck saat jaringan lambat.

SCRIPT="$0"
if command -v readlink >/dev/null 2>&1; then
  RESOLVED=$(readlink -f "$SCRIPT" 2>/dev/null || echo "$SCRIPT")
else
  RESOLVED="$SCRIPT"
fi
DIR=$(dirname "$RESOLVED")
if [ ! -f "$DIR/config.json" ] && [ -f "$HOME/folester-termux-bot/config.json" ]; then
  DIR="$HOME/folester-termux-bot"
fi
cd "$DIR" || exit 1
echo "Memulai bot akun kedua... (tunggu sampai muncul PID, sekitar 5-15 detik — jangan Ctrl+C)"
echo "Mematikan bot akun kedua yang lama..."
# (1) File PID bot baru (per file cookie) — paling tepat.
if [ -f "$HOME/.folester_session_cookies-akg8.txt.pid" ]; then
  OLDPID=$(cat "$HOME/.folester_session_cookies-akg8.txt.pid" 2>/dev/null)
  if [ -n "$OLDPID" ] && kill -0 "$OLDPID" 2>/dev/null; then kill "$OLDPID" 2>/dev/null; fi
fi
# (2) Bot lama dengan flag --cookies akg8 / --keypair bacj-key.txt.
pkill -f "folester_session_cookies-akg8" 2>/dev/null
pkill -f "bacj-key.txt" 2>/dev/null
echo "  bot lama dimatikan."
sleep 1
echo "Mengupdate dari GitHub (maks 10 detik — titik-titik di bawah tandanya masih jalan)..."
GIT_TERMINAL_PROMPT=0 git pull -q 2>/dev/null &
_GP=$!
_i=0
while kill -0 "$_GP" 2>/dev/null && [ "$_i" -lt 10 ]; do
  sleep 1
  _i=$((_i+1))
  printf "."
done
echo
if kill -0 "$_GP" 2>/dev/null; then
  kill "$_GP" 2>/dev/null
  wait "$_GP" 2>/dev/null
  echo "  (update dilewati: git pull >10 dtk — lanjut pakai versi lokal)"
elif wait "$_GP" 2>/dev/null; then
  echo "  (update selesai)"
else
  echo "  (update gagal — lanjut pakai versi lokal)"
fi
echo "Menjalankan bot akun kedua..."
nohup python3 bot.py --keypair ~/bacj-key.txt --cookies ~/.folester_session_cookies-akg8.txt > folester-akg8.log 2>&1 &
echo "Bot akun kedua jalan (PID $!). Cek log: log2"
