#!/bin/sh
# Pasang perintah `mulai` / `mulai2` supaya bisa diketik dari mana saja.
# Dijalankan dengan `sh` (tidak butuh izin eksekusi):
#   cd ~/folester-termux-bot && git pull && sh pasang
#   source ~/.bashrc
#   mulai
#
# Kenapa pakai wrapper, bukan symlink: file `mulai` di repo TIDAK PUNYA
# izin eksekusi (mode 100644) — GitHub tidak menyimpan mode +x untuk file
# yang di-push lewat API, dan `git pull` menimpa mode lokal jadi 100644
# lagi ("mode change 100755 => 100644"). Symlink ke file tanpa +x ikut
# gagal ("Permission denied"). Wrapper di ~/bin ini dibuat di HP sendiri
# dan diberi +x di sini, isinya cuma `sh .../mulai` — jadi `git pull`
# berikutnya tidak bisa merusaknya lagi.
#
# PENTING: `pasang` TIDAK memberi +x pada file repo. Dulu `pasang` melakukan
# itu supaya `./mulai` bisa dipakai — tapi `chmod +x` itu justru MENGOTORI
# repo (mode lokal 100755 vs repo 100644), sehingga `git pull` berikutnya
# selalu gagal "Your local changes to mulai/mulai2 would be overwritten"
# dan harus `git checkout --` dulu. Lingkaran itu yang terjadi 21 Nov.
# Wrapper tidak butuh +x pada file repo (dijalankan lewat `sh`), jadi
# biarkan file repo tetap 100644 — `git pull` jadi selalu bersih.
# Kalau mau `./mulai` langsung, jalankan `sh mulai` saja.
set -e
REPO="$HOME/folester-termux-bot"
# Bersihkan perubahan mode lokal yang ditinggal `pasang` versi lama
# (chmod +x pada mulai/mulai2) supaya `git pull` berikutnya tidak Aborting.
# Ini hanya mengembalikan dua file peluncur ke versi repo — jangan edit
# mulai/mulai2 langsung di HP, semua perubahan lewat GitHub.
git -C "$REPO" checkout -- mulai mulai2 2>/dev/null || true
mkdir -p "$HOME/bin"
cat > "$HOME/bin/mulai" <<'EOF'
#!/bin/sh
exec sh "$HOME/folester-termux-bot/mulai" "$@"
EOF
cat > "$HOME/bin/mulai2" <<'EOF'
#!/bin/sh
exec sh "$HOME/folester-termux-bot/mulai2" "$@"
EOF
chmod +x "$HOME/bin/mulai" "$HOME/bin/mulai2"
if ! grep -qs 'HOME/bin' "$HOME/.bashrc"; then
  echo 'export PATH="$HOME/bin:$PATH"' >> "$HOME/.bashrc"
  echo "PATH ditambahkan ke ~/.bashrc"
fi
echo "Terpasang. Jalankan: source ~/.bashrc"
echo "Lalu ketik: mulai"
